{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": false,
			"palette": [
				{ "slug": "paper", "name": "Paper", "color": "#F5EFE6" },
				{ "slug": "surface", "name": "Surface", "color": "#FFFCF7" },
				{ "slug": "ink", "name": "Espresso", "color": "#241A13" },
				{ "slug": "muted", "name": "Muted", "color": "#66564A" },
				{ "slug": "line", "name": "Line", "color": "#E2D6C6" },
				{ "slug": "accent", "name": "Cascara", "color": "#A23B26" },
				{ "slug": "accent-dark", "name": "Cascara dark", "color": "#7E2C1C" },
				{ "slug": "sage", "name": "Sage", "color": "#55634A" },
				{ "slug": "crema", "name": "Crema", "color": "#EBDDC8" }
			]
		},
		"layout": {
			"contentSize": "720px",
			"wideSize": "1200px"
		},
		"spacing": {
			"units": ["px", "rem", "%", "vw"],
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{ "slug": "20", "name": "XS", "size": "0.5rem" },
				{ "slug": "30", "name": "S", "size": "1rem" },
				{ "slug": "40", "name": "M", "size": "clamp(1.25rem, 2.5vw, 1.75rem)" },
				{ "slug": "50", "name": "L", "size": "clamp(1.75rem, 4vw, 2.75rem)" },
				{ "slug": "60", "name": "XL", "size": "clamp(2.5rem, 6vw, 4.5rem)" },
				{ "slug": "70", "name": "XXL", "size": "clamp(3.5rem, 9vw, 7rem)" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontFamilies": [
					{
						"slug": "display",
						"name": "Montserrat",
						"fontFamily": "Montserrat, 'Helvetica Neue', Arial, sans-serif",
						"fontFace": [
							{
								"fontFamily": "Montserrat",
								"fontStyle": "normal",
								"fontWeight": "100 900",
								"fontDisplay": "swap",
								"src": ["file:./assets/fonts/montserrat-wght.woff2"]
							}
						]
					},
					{
						"slug": "body",
						"name": "Inter",
						"fontFamily": "Inter, 'Helvetica Neue', Arial, sans-serif",
						"fontFace": [
							{
								"fontFamily": "Inter",
								"fontStyle": "normal",
								"fontWeight": "100 900",
								"fontDisplay": "swap",
								"src": ["file:./assets/fonts/inter-wght.woff2"]
							}
						]
					}
				],
				"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "0.9375rem", "fluid": false },
				{ "slug": "medium", "name": "Medium", "size": "1.0625rem", "fluid": false },
				{ "slug": "large", "name": "Large", "size": "1.25rem", "fluid": { "min": "1.125rem", "max": "1.3125rem" } },
				{ "slug": "x-large", "name": "XL", "size": "1.75rem", "fluid": { "min": "1.375rem", "max": "1.875rem" } },
				{ "slug": "xx-large", "name": "XXL", "size": "2.5rem", "fluid": { "min": "1.75rem", "max": "2.5rem" } },
				{ "slug": "huge", "name": "Huge", "size": "3.75rem", "fluid": { "min": "2.25rem", "max": "3.75rem" } }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--paper)",
			"text": "var(--wp--preset--color--ink)"
		},
		"spacing": {
			"blockGap": "1.25rem",
			"padding": {
				"left": "clamp(16px, 4vw, 32px)",
				"right": "clamp(16px, 4vw, 32px)"
			}
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.6"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "600",
					"lineHeight": "1.1",
					"letterSpacing": "-0.015em"
				}
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--huge)", "lineHeight": "1.02", "letterSpacing": "-0.03em" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)", "lineHeight": "1.2" } },
			"h4": { "typography": { "fontSize": "var(--wp--preset--font-size--large)", "lineHeight": "1.3" } },
			"link": {
				"color": { "text": "var(--wp--preset--color--accent-dark)" },
				"typography": { "textDecoration": "underline" },
				":hover": { "color": { "text": "var(--wp--preset--color--accent)" } },
				":focus-visible": { "outline": { "color": "var(--wp--preset--color--accent)", "style": "solid", "width": "2px", "offset": "3px" } }
			},
			"button": {
				"border": { "radius": "999px" },
				"color": {
					"background": "var(--wp--preset--color--accent)",
					"text": "var(--wp--preset--color--surface)"
				},
				"spacing": { "padding": { "top": "0.9rem", "bottom": "0.9rem", "left": "1.6rem", "right": "1.6rem" } },
				"typography": { "fontFamily": "var(--wp--preset--font-family--body)", "fontSize": "1rem", "fontWeight": "600", "lineHeight": "1.2" },
				":hover": { "color": { "background": "var(--wp--preset--color--accent-dark)", "text": "var(--wp--preset--color--surface)" } },
				":focus-visible": { "outline": { "color": "var(--wp--preset--color--ink)", "style": "solid", "width": "2px", "offset": "3px" } }
			},
			"caption": {
				"color": { "text": "var(--wp--preset--color--muted)" },
				"typography": { "fontSize": "var(--wp--preset--font-size--small)" }
			}
		},
		"blocks": {
			"core/navigation": {
				"typography": { "fontSize": "var(--wp--preset--font-size--medium)", "fontWeight": "500" },
				"elements": { "link": { "typography": { "textDecoration": "none" } } }
			},
			"core/site-title": {
				"typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontSize": "1.625rem", "fontWeight": "600", "letterSpacing": "-0.02em" },
				"elements": { "link": { "color": { "text": "var(--wp--preset--color--ink)" }, "typography": { "textDecoration": "none" } } }
			},
			"core/post-title": {
				"elements": { "link": { "color": { "text": "var(--wp--preset--color--ink)" }, "typography": { "textDecoration": "none" } } }
			},
			"core/separator": {
				"color": { "text": "var(--wp--preset--color--line)" }
			},
			"core/quote": {
				"border": { "left": { "color": "var(--wp--preset--color--accent)", "width": "3px", "style": "solid" } },
				"spacing": { "padding": { "left": "1.25rem" } },
				"typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontSize": "var(--wp--preset--font-size--x-large)", "fontWeight": "500", "lineHeight": "1.35" }
			},
			"core/table": {
				"typography": { "fontSize": "var(--wp--preset--font-size--small)" }
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	],
	"customTemplates": [
		{ "name": "page-wide", "title": "Page without title", "postTypes": ["page"] }
	]
}
